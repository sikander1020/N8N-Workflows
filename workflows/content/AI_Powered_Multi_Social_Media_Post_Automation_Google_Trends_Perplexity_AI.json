        "jsCode": "// Ensure results exist in the JSON\nconst results = $('Google Trends').first().json.results || [];\n\n// Filter for highly relevant results (score > 0.9)\nconst filtered = results.filter(item => item.score > 0.9);\n\n// Combine title and URL for each filtered result\nconst combined = filtered.map(item => `${item.title} (${item.url})`);\n\n// Return as a single JSON object\nreturn [{\n  json: {\n    answer: $('Google Trends').first().json.answer || null,   // Include Tavily's AI answer if present\n    filtered_results: combined\n  }\n}];\n"
      },
