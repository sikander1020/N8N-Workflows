      "parameters": {
        "jsCode": "// Get your content text from previous node\nconst content = $input.first().json.choices[0].message.content || \"An AI automation related topic\";\n\n// Basic keywords extraction (simple example, you can improve with NLP libs)\nfunction extractKeywords(text) {\n  // This is a very naive keyword extractor: just pick nouns or important words manually or split words\n  // For simplicity, here we take the first 5 words longer than 4 chars\n  return text\n    .split(/\\W+/)\n    .filter(w => w.length > 4)\n    .slice(0, 5)\n    .join(\", \");\n}\n\n// Compose Midjourney prompt dynamically based on content\nconst keywords = extractKeywords(content);\n\nconst imagePrompt = `Visualize a sophisticated AI agent workflow in a sleek digital interface style â€” multiple interconnected modules representing tasks like trend analysis, keyword extraction, topic selection, research, content generation, and social media posting. Use clean lines, tech-inspired colors like blue and purple, futuristic glowing nodes, and a modern UI design that conveys automation, intelligence, and seamless data flow in an AI-powered system.`;\n\n// Build the request body for Midjourney\nconst requestBody = {\n  taskType: \"mj_txt2img\",\n  speed: \"relaxed\",\n  prompt: imagePrompt,\n  aspectRatio: \"16:9\",\n  version: \"7\",\n  variety: 10,\n  stylization: 100,\n  weirdness: 50,\n  waterMark: \"\",\n  callBackUrl: \"\",\n  ow: 500\n};\n\nreturn [{\n  json: requestBody\n}];\n"
      },
