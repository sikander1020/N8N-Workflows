    {
      "parameters": {
        "jsCode": "// 1ï¸âƒ£ Get values from \"Set Prompts\" node\nconst promptText = $('Set Prompts').first().json.video_prompt || \"Default video prompt\";\n\n// 2ï¸âƒ£ Get image URL from \"GET Image Status\" node\nconst imageUrl = $('GET Image Status').first().json.data.resultInfoJson.resultUrls[3]?.resultUrl\n  || \"https://placeholder.url/fallback.jpg\";\n\n// 3ï¸âƒ£ Return payload for Runway API (NO model field)\nreturn [\n  {\n    json: {\n      prompt: promptText,\n      imageUrl: imageUrl,\n      duration: 5,               // 5 seconds\n      quality: \"720p\",           // 720p quality\n      aspectRatio: \"16:9\",       // fixed ratio\n      waterMark: \"\",             // no watermark\n      callBackUrl: \"https://your-callback-endpoint.com\"\n    }\n  }\n];\n"
