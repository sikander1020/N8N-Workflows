    {
      "parameters": {
        "jsCode": "// Get original image URL from \"creating url\" node\nconst url =$('creating url').first().json.data.downloadUrl;\nif (!url) {\n  throw new Error(\"No image URL found in 'creating url' node.\");\n}\n\n// Get the prompt directly from current node's JSON\nconst promptText = $('Set Prompts').first().json.image_prompt|| \"Default backup prompt\";\n\n// Build payload for image-to-image regeneration\nreturn [\n  {\n    json: {\n      taskType: \"mj_img2img\", // Regenerate from existing image\n      fileUrls: [url],\n      prompt: promptText,\n      speed: \"relaxed\",\n      aspectRatio: \"3:2\",\n      version: \"7\",\n      variety: 1,\n      stylization: 50,\n      weirdness: 0,\n      waterMark: \"\",\n      callBackUrl: \"\",\n      ow: 512\n    }\n  }\n];\n"
